# MONEYVERSE — Supabase client config
# Copy to .env (cp .env.example .env) and fill in real values for logged-in
# users to sync progress to Supabase. Guests work without these.

# Your Supabase project URL (from Project Settings → API)
VITE_SUPABASE_URL=

# Anon public key (from Project Settings → API)
VITE_SUPABASE_ANON_KEY=
